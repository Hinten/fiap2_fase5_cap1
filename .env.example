# IBM watsonx Assistant (nunca versione a chave real)
WATSON_API_KEY=
WATSON_URL=
WATSON_API_MODE=auto

# API V2 atual (assistant + environment); deixe vazio ao usar Dialog Skill V1.
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=

# Compatibilidade gratuita com Dialog Skill clássica; deixe vazio ao usar V2.
WATSON_WORKSPACE_ID=

WATSON_VERSION=2021-11-27

# Flask
FLASK_APP=src.backend.app:create_app
FLASK_ENV=development
PORT=5000
