# IBM watsonx Assistant (nunca versione a chave real)
WATSON_API_KEY=
WATSON_URL=
WATSON_API_MODE=auto

# API V2 atual (assistant + environment); deixe vazio ao usar Dialog Skill V1.
WATSON_ASSISTANT_ID=
WATSON_ENVIRONMENT_ID=

# Compatibilidade gratuita com Dialog Skill clássica; deixe vazio ao usar V2.
WATSON_WORKSPACE_ID=

WATSON_VERSION=2021-11-27

# IR ALÉM 1 - extração clínica com IA generativa (nunca versione a chave real).
# Sem LLM_API_KEY, /api/extract e /api/chat/clinical usam o modo de simulação (mock).
# Qualquer provedor com API compatível com Chat Completions funciona; escolha um bloco:
#   Google Gemini (free tier: ~20 requisições/dia por modelo; se esgotar, troque LLM_MODEL,
#   por exemplo para gemini-3.5-flash-lite; usado nos testes do projeto):
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-3.5-flash
#   OpenAI (deixe LLM_BASE_URL vazio):
#     LLM_MODEL=gpt-4o-mini
#   Groq (free tier):
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Flask
FLASK_APP=src.backend.app:create_app
FLASK_ENV=development
PORT=5000
